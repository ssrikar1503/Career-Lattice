# Career Pathways Platform — Pipeline environment variables
# Copy this file to .env and fill in real values.

# ─── Database (Cloud SQL for PostgreSQL) ─────────────────────────────────────
# Standard libpq / psycopg connection string.
# TCP form (e.g. via the Cloud SQL Auth proxy on localhost, or a direct host):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/careerlattice
# Cloud SQL Unix-socket form (Cloud Run / GitHub Actions with the Auth proxy):
# DATABASE_URL=postgresql://USER:PASSWORD@/careerlattice?host=/cloudsql/PROJECT:REGION:INSTANCE

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Anthropic Claude (primary — used for extraction + matching)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional fallback — used when Claude hits rate limits)
# Get free key: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day — generous for backup
GEMINI_API_KEY=AIza...
