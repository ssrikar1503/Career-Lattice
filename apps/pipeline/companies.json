    "industry": "one of: additive-manufacturing | semiconductors | space",
    "tenant": "(workday only) subdomain, e.g. 'intel' in intel.wd1.myworkdayjobs.com",
    "wd": "(workday only) datacenter number, e.g. 1 or 5 from .wd1. or .wd5.",
    "site": "(workday only) site path, e.g. 'External' or 'NVIDIAExternalCareerSite'",
    "title_keywords": "optional list: keep only postings whose title contains one of these (huge boards)",
    "locations_include": "optional list: keep only postings whose location text contains one of these (global boards)",
    "region": "optional, lever only: 'eu' routes to api.eu.lever.co"
  },
